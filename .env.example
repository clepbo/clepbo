# Copy to .env.local for local development, and set the same three on Vercel
# (Project → Settings → Environment Variables). Nothing else is required.

# The password you type at /admin/login. Pick something long.
ADMIN_PASSWORD=

# Signs the admin session cookie. Any long random string:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# From console.anthropic.com — powers the rewrite buttons in the editor.
ANTHROPIC_API_KEY=

# Created for you when you add Blob storage in the Vercel dashboard
# (Storage → Create → Blob). Run `vercel env pull` to get it locally.
# Without it the editor falls back to writing .data/content.json on disk.
BLOB_READ_WRITE_TOKEN=

# ── The contact form needs ONE of these two. Gmail is checked first. ──
#
# Option A — your own Gmail. Needs 2-Step Verification turned on, then
# myaccount.google.com/apppasswords to generate a 16-character password.
# Nothing to verify, no new account, and confirmations reach real people
# straight away. Personal Gmail only — Workspace accounts can't use these.
GMAIL_USER=
GMAIL_APP_PASSWORD=
#
# Option B — resend.com. Add the Resend integration in Vercel and this is
# set for you. Better once you have your own domain to send from.
RESEND_API_KEY=

# Optional — your real domain, used to resolve the og:image URL and to sign
# the links in enquiry emails.
SITE_URL=
